static constexpr size_t BANNER_READ_BYTES=4096;
struct ScanResult{
std::string host;
int port=0;
std::string service_guess;
bool reachable=false;
std::string banner;
std::map<std::string,std::string> http_headers;
std::vector<std::string> notes;
double duration_s=0.0;
};
static std::once_flag openssl_init_flag;
static void initialize_openssl(){
std::call_once(openssl_init_flag,[](){
SSL_library_init();
SSL_load_error_strings();
OpenSSL_add_all_algorithms();
});
}
static bool set_socket_timeout(int sockfd,double seconds){
timeval tv{};
tv.tv_sec=static_cast<int>(seconds);
tv.tv_usec=static_cast<int>((seconds-tv.tv_sec)*1000000);
if(setsockopt(sockfd,SOL_SOCKET,SO_RCVTIMEO,&tv,sizeof(tv))<0)
return false;
if(setsockopt(sockfd,SOL_SOCKET,SO_SNDTIMEO,&tv,sizeof(tv))<0)
return false;
return true;
}
static std::string recv_all(int sockfd,double timeout,size_t max_bytes=BANNER_READ_BYTES){
set_socket_timeout(sockfd,timeout);
std::string buffer;
buffer.reserve(max_bytes);
char tmp[2048];
while(buffer.size()<max_bytes){
ssize_t n=recv(sockfd,tmp,sizeof(tmp),0);
if(n<=0)
break;
buffer.append(tmp,static_cast<size_t>(n));
if(buffer.find("\r\n\r\n")!=std::string::npos)
break;
}
return buffer;
}
static void parse_http_response(const std::string& data,std::map<std::string,std::string>& headers,std::vector<std::string>& notes){
std::istringstream ss(data);
std::string line;
if(!std::getline(ss,line))
return;
if(!line.empty()&&line.back()=='\r')
line.pop_back();
headers["status_line"]=line;
std::istringstream status(line);
std::string http_version;
int status_code=0;
std::string reason;
if(status>>http_version>>status_code){
std::getline(status,reason);
if(!reason.empty()&&reason.front()==' ')
reason.erase(0,1);
headers["status_code"]=std::to_string(status_code);
headers["reason"]=reason;
if(status_code!=200)
notes.push_back("HTTP non-200 status: "+std::to_string(status_code));
}else{
notes.push_back("Malformed HTTP status line");
return;
}
while(std::getline(ss,line)){
if(!line.empty()&&line.back()=='\r')
line.pop_back();
if(line.empty())
break;
auto pos=line.find(':');
if(pos==std::string::npos)
continue;
std::string key=line.substr(0,pos);
std::string value=line.substr(pos+1);
size_t start=value.find_first_not_of(" \t");
if(start!=std::string::npos)
value=value.substr(start);
headers[key]=value;
}
}
static void probe_https(int sockfd,const std::string& host,double timeout,ScanResult& out){
initialize_openssl();
SSL_CTX* ctx=SSL_CTX_new(TLS_client_method());
if(!ctx){
out.notes.push_back("SSL_CTX_new failed");
return;
}
const unsigned char alpn_protos[]={2,'h','2',8,'h','t','t','p','/','1','.','1'};
SSL_CTX_set_alpn_protos(ctx,alpn_protos,sizeof(alpn_protos));
SSL* ssl=SSL_new(ctx);
if(!ssl){
out.notes.push_back("SSL_new failed");
SSL_CTX_free(ctx);
return;
}
SSL_set_fd(ssl,sockfd);
SSL_set_tlsext_host_name(ssl,host.c_str());
set_socket_timeout(sockfd,timeout);
if(SSL_connect(ssl)!=1){
out.notes.push_back("TLS handshake failed");
SSL_free(ssl);
SSL_CTX_free(ctx);
return;
}
out.reachable=true;
out.notes.push_back("TLS version: "+std::string(SSL_get_version(ssl)));
const char* cipher=SSL_get_cipher(ssl);
if(cipher)
out.notes.push_back("Cipher: "+std::string(cipher));
const unsigned char* proto=nullptr;
unsigned int proto_len=0;
SSL_get0_alpn_selected(ssl,&proto,&proto_len);
if(proto_len>0)
out.notes.push_back("ALPN protocol: "+std::string(reinterpret_cast<const char*>(proto),proto_len));
X509* cert=SSL_get_peer_certificate(ssl);
if(cert){
char* subj=X509_NAME_oneline(X509_get_subject_name(cert),nullptr,0);
char* iss=X509_NAME_oneline(X509_get_issuer_name(cert),nullptr,0);
if(subj)
out.notes.push_back(std::string("TLS Subject: ")+subj);
if(iss)
out.notes.push_back(std::string("TLS Issuer: ")+iss);
OPENSSL_free(subj);
OPENSSL_free(iss);
X509_free(cert);
}
std::ostringstream request;
request<<"HEAD / HTTP/1.1\r\nHost: "<<host<<"\r\nUser-Agent: banner-scanner/1.0\r\nConnection: close\r\n\r\n";
std::string req=request.str();
if(SSL_write(ssl,req.data(),static_cast<int>(req.size()))<=0)
out.notes.push_back("TLS HTTP request failed");
char buffer[2048];
std::string response;
int bytes=0;
while((bytes=SSL_read(ssl,buffer,sizeof(buffer)))>0){
response.append(buffer,static_cast<size_t>(bytes));
if(response.find("\r\n\r\n")!=std::string::npos)
break;
}
out.banner=response;
parse_http_response(response,out.http_headers,out.notes);
auto server=out.http_headers.find("Server");
if(server!=out.http_headers.end()){
std::string normalized=server->second;
if(normalized.find("Apache")!=std::string::npos)
normalized="Apache";
else if(normalized.find("nginx")!=std::string::npos)
normalized="nginx";
else if(normalized.find("Microsoft-IIS")!=std::string::npos)
normalized="IIS";
out.notes.push_back("Normalized server: "+normalized);
}
SSL_shutdown(ssl);
SSL_free(ssl);
SSL_CTX_free(ctx);
}
static ScanResult probe_tcp_banner(const std::string& host,int port,double timeout){
ScanResult out;
out.host=host;
out.port=port;
auto service=DEFAULT_PORTS.find(port);
out.service_guess=service!=DEFAULT_PORTS.end()?service->second:"unknown";
auto start=high_resolution_clock::now();
addrinfo hints{},*res=nullptr;
hints.ai_family=AF_UNSPEC;
hints.ai_socktype=SOCK_STREAM;
if(getaddrinfo(host.c_str(),nullptr,&hints,&res)!=0){
out.notes.push_back("DNS resolution failed");
return out;
}
int sockfd=-1;
for(addrinfo* rp=res;rp;rp=rp->ai_next){
sockfd=socket(rp->ai_family,rp->ai_socktype,rp->ai_protocol);
if(sockfd<0)
continue;
if(rp->ai_family==AF_INET)
reinterpret_cast<sockaddr_in*>(rp->ai_addr)->sin_port=htons(static_cast<uint16_t>(port));
else if(rp->ai_family==AF_INET6)
reinterpret_cast<sockaddr_in6*>(rp->ai_addr)->sin6_port=htons(static_cast<uint16_t>(port));
else{
close(sockfd);
sockfd=-1;
continue;
}
set_socket_timeout(sockfd,timeout);
if(connect(sockfd,rp->ai_addr,rp->ai_addrlen)==0)
break;
close(sockfd);
sockfd=-1;
}
freeaddrinfo(res);
if(sockfd<0){
out.notes.push_back("connect failed");
return out;
}
set_socket_timeout(sockfd,timeout);
if(port==443){
probe_https(sockfd,host,timeout,out);
}else if(port==80){
std::ostringstream request;
request<<"HEAD / HTTP/1.1\r\nHost: "<<host<<"\r\nUser-Agent: banner-scanner/1.0\r\nConnection: close\r\n\r\n";
std::string req=request.str();
if(send(sockfd,req.data(),req.size(),0)<0)
out.notes.push_back("HTTP send error: "+std::string(strerror(errno)));
std::string data=recv_all(sockfd,timeout);
out.banner=data;
parse_http_response(data,out.http_headers,out.notes);
}else{
out.banner=recv_all(sockfd,timeout);
}
close(sockfd);
out.duration_s=duration<double>(high_resolution_clock::now()-start).count();
if(!out.banner.empty()||port==443)
out.reachable=true;
return out;
}
int main(int argc,char* argv[]){
if(argc<2){
std::cerr<<"Usage:\n"
<<"  "<<argv[0]
<<" target_host [--domains domains.txt] [--timeout 3.0] [--threads 8] [--json out.json]\n";
return 1;
}
std::vector<std::string> hosts;
std::string domains_file;
double timeout=3.0;
size_t thread_count=8;
std::string json_out;
for(int i=1;i<argc;++i){
std::string arg=argv[i];
if(arg=="--timeout"&&i+1<argc){
try{
timeout=std::stod(argv[++i]);
}catch(...){
std::cerr<<"Invalid timeout value\n";
return 1;
}
}else if(arg=="--threads"&&i+1<argc){
try{
thread_count=std::stoul(argv[++i]);
}catch(...){
std::cerr<<"Invalid thread count\n";
return 1;
}
}else if(arg=="--json"&&i+1<argc){
json_out=argv[++i];
}else if(arg=="--domains"&&i+1<argc){
domains_file=argv[++i];
}else if(!arg.empty()&&arg[0]!='-'){
hosts.push_back(arg);
}
}
if(timeout<=0){
std::cerr<<"Timeout must be greater than zero\n";
return 1;
}
if(thread_count==0){
thread_count=1;
}
if(!domains_file.empty()){
std::ifstream file(domains_file);
if(!file){
std::cerr<<"Failed to open domains file: "<<domains_file<<"\n";
return 1;
}
std::string domain;
while(std::getline(file,domain)){
domain.erase(std::remove_if(domain.begin(),domain.end(),[](unsigned char c){
return c=='\r'||c=='\n';
}),domain.end());
if(!domain.empty())
hosts.push_back(domain);
}
}
if(hosts.empty()){
std::cerr<<"No domains provided.\n";
return 1;
}
std::vector<std::pair<int,std::string>> ports;
ports.reserve(DEFAULT_PORTS.size());
for(const auto& entry:DEFAULT_PORTS)
ports.push_back(entry);
std::mutex result_mutex;
std::mutex queue_mutex;
std::vector<ScanResult> results;
results.reserve(hosts.size()*ports.size());
std::queue<size_t> work;
for(size_t i=0;i<ports.size();++i)
work.push(i);
auto worker=[&](){
while(true){
size_t index=0;
{
std::lock_guard<std::mutex> lock(queue_mutex);
if(work.empty())
return;
index=work.front();
work.pop();
}
const auto& port_entry=ports[index];
for(const auto& host:hosts){
ScanResult result=probe_tcp_banner(host,port_entry.first,timeout);
std::lock_guard<std::mutex> lock(result_mutex);
results.push_back(std::move(result));
}
}
};
std::vector<std::thread> workers;
workers.reserve(thread_count);
for(size_t i=0;i<thread_count;++i)
workers.emplace_back(worker);
for(auto& worker_thread:workers)
worker_thread.join();
for(const auto& result:results){
std::cout<<"["<<result.host<<":"<<result.port<<"] ";
if(!result.reachable){
std::cout<<"unreachable\n";
continue;
}
std::cout<<"reachable ("<<std::fixed<<std::setprecision(2)
<<result.duration_s<<"s)\n";
if(!result.banner.empty())
std::cout<<result.banner<<"\n";
for(const auto& note:result.notes)
std::cout<<"  - "<<note<<"\n";
std::cout<<"\n";
}
if(!json_out.empty()){
std::ofstream jf(json_out);
if(!jf){
std::cerr<<"Failed to open JSON output file: "<<json_out<<"\n";
return 1;
}
auto escape_json=[](const std::string& input){
std::string output;
output.reserve(input.size()+16);
for(char c:input){
switch(c){
case '"': output+="\\\""; break;
case '\\': output+="\\\\"; break;
case '\b': output+="\\b"; break;
case '\f': output+="\\f"; break;
case '\n': output+="\\n"; break;
case '\r': output+="\\r"; break;
case '\t': output+="\\t"; break;
default: output+=c; break;
}
}
return output;
};
jf<<"{\n";
jf<<"  \"results\": [\n";
for(size_t i=0;i<results.size();++i){
const auto& r=results[i];
jf<<"    {\n";
jf<<"      \"host\": \""<<escape_json(r.host)<<"\",\n";
jf<<"      \"port\": "<<r.port<<",\n";
jf<<"      \"service\": \""<<escape_json(r.service_guess)<<"\",\n";
jf<<"      \"reachable\": "<<(r.reachable?"true":"false")<<",\n";
jf<<"      \"duration\": "<<r.duration_s<<",\n";
jf<<"      \"banner\": \""<<escape_json(r.banner)+"\",\n";
jf<<"      \"headers\": {\n";
size_t header_index=0;
for(const auto& header:r.http_headers){
jf<<"        \""<<escape_json(header.first)<<"\": \""<<escape_json(header.second)<<"\"";
if(++header_index<r.http_headers.size())
jf<<",";
jf<<"\n";
}
jf<<"      },\n";
jf<<"      \"notes\": [";
for(size_t n=0;n<r.notes.size();++n){
jf<<"\""<<escape_json(r.notes[n])<<"\"";
if(n+1<r.notes.size())
jf<<", ";
}
jf<<"]\n";
jf<<"    }";
if(i+1<results.size())
jf<<",";
jf<<"\n";
}
jf<<"  ]\n";
jf<<"}\n";
}
